    {
      "name": "01 - HU-14 Enviar SMS",
      "description": "POST /sms (solo EMPLEADO). Lo usa plazoleta para enviar el PIN cuando un pedido queda LISTO. Por defecto el envio es simulado y se registra en la consola de mensajeria.",
      "item": [
        {
          "name": "Enviar SMS (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sms"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{employeeToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+573005698325\",\n  \"message\": \"Tu pedido #7 esta listo. Presenta este PIN para reclamarlo: 482913\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Estado ENVIADO\", () => pm.expect(body.status).to.eql(\"ENVIADO\"));",
                  "pm.test(\"Devuelve el celular destino\", () => pm.expect(body.phoneNumber).to.eql(\"+573005698325\"));"
                ]
              }
            }
          ]
        },
