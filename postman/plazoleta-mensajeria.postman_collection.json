{
  "info": {
    "name": "Plazoleta - Mensajeria",
    "description": "Pruebas del microservicio plazoleta-mensajeria (POST /sms, HU-14).\n\nRequiere levantados: usuarios ({{usuariosUrl}}) para obtener los tokens, plazoleta ({{plazoletaUrl}}) para crear el restaurante del empleado y mensajeria ({{baseUrl}}).\nOrden de ejecucion: 00 Preparacion -> 01 HU-14 (usar el Collection Runner).\nPor defecto el SMS es simulado: el mensaje se ve en la consola de mensajeria ([SMS SIMULADO] ...).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Preparacion (usuarios y plazoleta)",
      "description": "Obtiene un token de cada rol: ADMIN, PROPIETARIO, EMPLEADO (de un restaurante nuevo) y CLIENTE.",
      "item": [
        {
          "name": "Login ADMIN (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{usuariosUrl}}/auth/login",
              "host": [
                "{{usuariosUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"adminToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
